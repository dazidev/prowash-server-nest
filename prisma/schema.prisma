generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

//* MODELO PARA LOS USUARIOS DE LA APP MOBILE
enum UserRole {
  ADMIN
  MOD
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                     String                     @id @default(uuid())
  name                   String
  lastname               String
  email                  String                     @unique
  password               String
  phoneNumber            String?                    @db.VarChar(20)
  isEmailVerified        Boolean                    @default(false)
  isPhoneNumberVerified  Boolean                    @default(false)
  roles                  UserRole[]
  status                 UserStatus                 @default(ACTIVE)
  lastLogin              DateTime?                  @db.Timestamptz()
  createdAt              DateTime                   @default(now()) @db.Timestamptz()
  updatedAt              DateTime                   @updatedAt @db.Timestamptz()

  EmailVerificationCodes EmailVerificationCodes[]
  UserHouse              UserHouse[]
  userSessions           UserSession[]
  packageOrders          PackageOrder[]
  pushDevices            PushDevice[]
  quoteNotifications     QuoteNotificationOutbox[]

  @@index([status])
  @@index([roles])
  @@map("users") // nombre de la tabla
}

model UserSession {
  id            String       @id @default(uuid())
  refreshToken  String
  expiresAt     DateTime     @db.Timestamptz()
  isRevoked     Boolean      @default(false)
  revokedAt     DateTime?    @db.Timestamptz()
  revokedReason String?
  deviceId      String
  deviceInfo    String
  ipAddress     String
  createdAt     DateTime     @default(now()) @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @db.Timestamptz()
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDevice    PushDevice?

  @@index([refreshToken])
  @@index([userId, isRevoked])
  @@index([userId, id])
  @@index([isRevoked, expiresAt])
  @@map("user_sessions")
}

//* MODELO PARA LAS NOTIFICACIONES

enum PushDevicePlatform {
  ANDROID
  IOS
}

model PushDevice {
  id         String              @id @default(uuid())
  deviceId   String              @unique
  fcmToken   String              @unique @db.VarChar(2048)
  platform   PushDevicePlatform
  isActive   Boolean             @default(true)

  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId  String              @unique
  session    UserSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  lastSeenAt DateTime            @default(now()) @db.Timestamptz()
  createdAt  DateTime            @default(now()) @db.Timestamptz()
  updatedAt  DateTime            @updatedAt @db.Timestamptz()

  @@index([userId, isActive])
  @@index([lastSeenAt])
  @@map("push_devices")
}

//* MODELOS PARA LOS CÓDIGOS A LOS CORREOS ELECTRONICOS
enum VerificationStatus {
  PENDING
  USED
  EXPIRED
}

enum VerificationPurpose {
  EMAIL_VERIFY // verificar correo
  EMAIL_CHANGE // cambio de correo
}

model EmailVerificationCodes {
  id         String               @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedCode String

  // gestión de uso
  purpose    VerificationPurpose  @default(EMAIL_VERIFY)
  status     VerificationStatus   @default(PENDING)

  // gestión de vida
  expiresAt  DateTime             @db.Timestamptz()
  consumedAt DateTime?            @db.Timestamptz()
  createdAt  DateTime             @default(now()) @db.Timestamptz()
  updatedAt  DateTime             @updatedAt @db.Timestamptz()

  @@unique([userId, hashedCode, purpose])
  @@index([userId, status])
  @@index([userId, purpose, status])
  @@index([userId, createdAt])
  @@index([userId, status, purpose, hashedCode])
  @@map("email_verification_codes") // nombre de la tabla
}

//* MODELOS PARA EL SISTEMA DE CASAS
model UserHouse {
  id               String          @id @default(uuid())
  name             String
  street           String
  complementStreet String?
  city             String
  state            String
  zipcode          String
  imageUrl         String?
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now()) @db.Timestamptz()
  updatedAt        DateTime        @updatedAt @db.Timestamptz()

  packageOrders    PackageOrder[]

  @@unique([userId, name]) // El usuario no podrá tener dos casas con el mismo nombre
  @@index([userId])
  @@map("user_houses")
}

//* MODELOS PARA LOS ADMINISTRADORES

enum AdminRole {
  GENERAL_ADMIN
}

model Admin {
  id             String     @id @default(uuid())
  name           String
  lastname       String
  email          String     @unique
  password       String
  role           AdminRole  @default(GENERAL_ADMIN)
  lastConnection DateTime?  @db.Timestamptz()
  createdAt      DateTime   @default(now()) @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @db.Timestamptz()

  @@map("admins")
}

//* MODELO DE PUBLICIDAD

enum AdTypes {
  TEXT
  IMAGE
  IMAGE_CAROUSEL
  VIDEO
}

model Advertising {
  id        String    @id @default(uuid())
  type      AdTypes
  order     Int       @unique
  text      String?
  image1    String?
  image2    String?
  image3    String?
  image4    String?
  image5    String?
  video     String?
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()

  @@map("advertising")
}

//* MODELO DE PAQUETES

model PackageService {
  id                 String               @id @default(uuid())
  name               String               @unique
  createdAt          DateTime             @default(now()) @db.Timestamptz()
  updatedAt          DateTime             @updatedAt @db.Timestamptz()
  ServiceOnPackage   ServiceOnPackage[]
  IndividualServices IndividualService[]

  @@map("package_services")
}

model Package {
  id               String              @id @default(uuid())
  name             String              @unique
  createdAt        DateTime            @default(now()) @db.Timestamptz()
  updatedAt        DateTime            @updatedAt @db.Timestamptz()
  ServiceOnPackage ServiceOnPackage[]
  PackagePrice     PackagePrice[]

  @@map("packages")
}

model ServiceOnPackage {
  id        String          @id @default(uuid())
  amount    Int
  serviceId String
  service   PackageService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId String
  package   Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @db.Timestamptz()
  updatedAt DateTime        @updatedAt @db.Timestamptz()

  @@unique([serviceId, packageId])
  @@index([packageId])
  @@map("services_on_packages")
}

model PackageRange {
  id           String          @id @default(uuid())
  description  String
  unit         String
  createdAt    DateTime        @default(now()) @db.Timestamptz()
  updatedAt    DateTime        @updatedAt @db.Timestamptz()
  PackagePrice PackagePrice[]

  @@map("package_ranges")
}

model PackagePrice {
  id        String        @id @default(uuid())
  price     Int
  packageId String
  package   Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  rangeId   String
  range     PackageRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @db.Timestamptz()
  updatedAt DateTime      @updatedAt @db.Timestamptz()

  @@map("package_prices")
}

enum PackageOrderPurchaseStatus {
  PENDING_REVIEW
  ASSIGNED_APPOINTMENT
  APPOINTMENT_RESCHEDULE_REQUESTED
  QUOTED
  PAID
  CANCELLED
}

model PackageOrder {
  id                    String                      @id @default(uuid())
  name                  String
  initialPrice          Int
  finalPrice            Int?
  finalPriceVersion     Int                         @default(0)
  range                 Int
  userId                String
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId               String
  userHouse             UserHouse                  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  purchaseStatus        PackageOrderPurchaseStatus  @default(PENDING_REVIEW)
  services              Json

  appointmentAt         DateTime?                   @db.Timestamptz()
  appointmentTimeZone   String?
  appointmentAcceptedAt DateTime?                   @db.Timestamptz()
  appointmentVersion    Int                         @default(0)

  quoteNotifications    QuoteNotificationOutbox[]

  createdAt             DateTime                    @default(now()) @db.Timestamptz()
  updatedAt             DateTime                    @updatedAt @db.Timestamptz()

  @@map("package_orders")
}

model Review {
  id        String    @id @default(uuid())
  name      String
  rating    Int
  comment   String
  createdAt DateTime  @default(now()) @db.Timestamptz()

  @@map("reviews")
}

enum ContactStatus {
  ATTENDED
  NOT_ATTENDED
}

model Contact {
  id        String         @id @default(uuid())
  name      String
  lastname  String?
  zipcode   String?
  email     String
  phone     String
  comments  String
  status    ContactStatus
  createdAt DateTime       @default(now()) @db.Timestamptz()
  updatedAt DateTime       @updatedAt @db.Timestamptz()

  @@map("contacts")
}

model IndividualService {
  id           String          @id @default(uuid())
  initialPrice Int
  serviceId    String          @unique
  service      PackageService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("individual_services")
}

enum WebQuoteRequestStatus {
  PENDING_REVIEW
  ATTENDED
  CANCELLED
}

model WebQuoteRequest {
  id             String                 @id @default(uuid())
  name           String
  lastname       String?
  email          String
  phone          String
  zipcode        String?
  comments       String

  packageId      String
  packagePriceId String

  packageName    String
  initialPrice   Int
  rangeName      String
  rangeUnit      String
  services       Json

  status         WebQuoteRequestStatus  @default(PENDING_REVIEW)
  createdAt      DateTime               @default(now()) @db.Timestamptz()
  updatedAt      DateTime               @updatedAt @db.Timestamptz()

  @@index([status, createdAt])
  @@map("web_quote_requests")
}

enum QuoteNotificationType {
  APPOINTMENT_ASSIGNED
  FINAL_PRICE_ASSIGNED
}

enum QuoteNotificationStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model QuoteNotificationOutbox {
  id                 String                   @id @default(uuid())
  type               QuoteNotificationType
  status             QuoteNotificationStatus  @default(PENDING)
  version            Int

  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  quoteId            String
  quote              PackageOrder            @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  appointmentAt      DateTime?                @db.Timestamptz()
  finalPrice         Int?

  attempts           Int                      @default(0)
  availableAt        DateTime                 @default(now()) @db.Timestamptz()

  lockToken          String?
  lockedUntil        DateTime?                @db.Timestamptz()

  completedDeviceIds String[]                 @default([])

  lastError          String?                  @db.VarChar(256)
  completedAt        DateTime?                @db.Timestamptz()

  createdAt          DateTime                 @default(now()) @db.Timestamptz()
  updatedAt          DateTime                 @updatedAt @db.Timestamptz()

  @@unique([quoteId, type, version])
  @@index([userId])
  @@index([status,   availableAt])
  @@index([status,   lockedUntil])
  @@map("quote_notification_outbox")
}
